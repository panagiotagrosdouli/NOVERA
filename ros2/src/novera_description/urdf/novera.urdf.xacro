<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="novera_one">
 <xacro:arg name="wheel_radius" default="0.076"/><xacro:arg name="track" default="0.382"/>
 <xacro:property name="radius" value="$(arg wheel_radius)"/><xacro:property name="track" value="$(arg track)"/>
 <xacro:macro name="inertia" params="mass ix iy iz"><inertial><mass value="${mass}"/><inertia ixx="${ix}" ixy="0" ixz="0" iyy="${iy}" iyz="0" izz="${iz}"/></inertial></xacro:macro>
 <link name="base_footprint"/><joint name="base_fixed" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.13"/></joint>
 <link name="base_link"><xacro:inertia mass="30" ix="2.5" iy="2.5" iz="1.2"/><visual><geometry><box size="0.468 0.468 0.17"/></geometry></visual><collision><geometry><box size="0.468 0.468 0.17"/></geometry></collision></link>
 <xacro:macro name="wheel" params="side sign"><link name="${side}_wheel"><xacro:inertia mass="1" ix="0.002" iy="0.003" iz="0.002"/><visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="${radius}" length="0.042"/></geometry></visual><collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="${radius}" length="0.042"/></geometry></collision></link><joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${sign*track/2} ${radius-0.13}"/><axis xyz="0 1 0"/></joint></xacro:macro>
 <xacro:wheel side="left" sign="1"/><xacro:wheel side="right" sign="-1"/>
 <xacro:macro name="caster" params="name x"><link name="${name}"><xacro:inertia mass="0.5" ix="0.001" iy="0.001" iz="0.001"/><visual><geometry><sphere radius="0.035"/></geometry></visual><collision><geometry><sphere radius="0.035"/></geometry></collision></link><joint name="${name}_fixed" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.095"/></joint><gazebo reference="${name}"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo></xacro:macro><xacro:caster name="front_caster" x="0.173"/><xacro:caster name="rear_caster" x="-0.173"/>
 <link name="body"><xacro:inertia mass="3" ix="0.18" iy="0.18" iz="0.03"/><visual><geometry><box size="0.235 0.272 0.875"/></geometry></visual><collision><geometry><box size="0.235 0.272 0.875"/></geometry></collision></link><joint name="body_fixed" type="fixed"><parent link="base_link"/><child link="body"/><origin xyz="0 0 0.4825"/></joint>
 <link name="laser_frame"/><joint name="laser_fixed" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0.18 0 0.16"/></joint>
 <gazebo reference="laser_frame"><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><update_rate>10</update_rate><gz_frame_id>laser_frame</gz_frame_id><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.1</min><max>10</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
 <link name="imu_link"/><joint name="imu_fixed" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint><gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>imu</topic><update_rate>50</update_rate><gz_frame_id>imu_link</gz_frame_id></sensor></gazebo>
 <link name="camera_link"/><joint name="camera_fixed" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.13 0 0.75"/></joint><gazebo reference="camera_link"><sensor name="rgbd" type="rgbd_camera"><topic>camera</topic><update_rate>15</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8</far></clip></camera></sensor></gazebo>
 <gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>${track}</wheel_separation><wheel_radius>${radius}</wheel_radius><topic>cmd_vel</topic><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><max_linear_velocity>0.25</max_linear_velocity><max_angular_velocity>0.6</max_angular_velocity></plugin><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>joint_states</topic></plugin></gazebo>
</robot>
